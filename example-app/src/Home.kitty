import { Nav, Card, NavList } from './components.kitty'
import { greet } from './Greetings.kitty'
import { Shapes } from './Shapes.kitty'

private purr doubled(n) {
    return (n * 2)
}

purr isAdult(age) {
    return (age >= 18)
}

purr isWorkingAge(age) {
    return (age >= 18 && age <= 65)
}

func Home() {
    <{count}> >> #n 0
    <{username}> >> 'Admin'
    <{ready}> >> yes>
    <{age}> >> 25
    <{sections}> >> #w[] ['Home', 'About', 'Contact']
    <{prices}> >> #n{} stash { milk: 2, eggs: 3, bread: 4 }
    craft<prices.get('milk').cloned().unwrap_or_default()>
    craft<stash { a: 1, b: 2 }>
    <{revenue}> >> #n 1234567.891
    craft<revenue.fixed(2)>
    craft<revenue.grouped()>
    craft<count.padded(4)>
    warn<'demonstrating warn< -- a real leptos::logging::warn! call'>
    error<'demonstrating error< -- a real leptos::logging::error! call'>

    if><{username}> >> 'Admin'
        craft<'Welcome Admin'>
    orif><{username}> >> 'User'
        craft<'Welcome User'>
    else>
        craft<'no output'>

    if><{age}> >= 18
        craft<'adult'>
    orif><{age}> < 13
        craft<'child'>
    else>
        craft<'teen'>

    if><{age}> >= 18 && <{ready}> >> yes>
        craft<'ready adult'>
    orif><{age}> < 13 || <{age}> >= 65
        craft<'discount age'>

    craft<isAdult(age)>
    craft<isWorkingAge(age)>
    craft<greet('World')>

    spin<{n}> in [1, 2, 3] }{
        craft<n>
    }{

    return (
        <div>
            <Nav active='Counter'/>
            <button onClick={<{count}> >> count + 1}>
                'Clicks: '
                <{count}>
                ' (doubled: '
                { doubled(count) }
                ')'
            </button>
            <p>
                'Username: '
                <{username}>
                <button onClick={<{username}> >> 'Guest'}>'Reset to Guest'</button>
                <input placeholder='Type a username' onInput={<{username}> >> event}/>
            </p>
            <ul>
                spin<{n}> in [1, 2, 3] }{
                    <li>{ n }</li>
                }{
            </ul>
            <Card title='About this page'>
                <p>"This card's children came from the composing view."</p>
            </Card>
            <NavList items={sections}/>
            <p>'Milk costs: ' { prices.get('milk').cloned().unwrap_or_default() }</p>
            <p>
                'Revenue: $'
                { revenue.fixed(2) }
                ' ('
                { revenue.grouped() }
                ') / order #'
                { count.padded(4) }
            </p>
            <Shapes/>
        </div>
    )
}
