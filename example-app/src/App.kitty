func App() {
    <{count}> >> <<Num>> 0
    <{username}> >> 'Admin'
    <{ready}> >> yes>

    if><{username}> >> 'Admin'
        craft<'Welcome Admin'>
    orif><{username}> >> "User"
        craft<"Welcome User">
    else>
        craft<'no output'>

    spin<{n}> in [1, 2, 3] }{
        craft<n>
    }{

    return (
        <div>
            <button onClick={<{count}> >> count + 1}>
                "Clicks: "
                <{count}>
            </button>
        </div>
    )
}
