{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kittine",
  "scopeName": "source.kitty",
  "fileTypes": ["kitty"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#craft" },
    { "include": "#type-tags" },
    { "include": "#booleans" },
    { "include": "#control-keywords" },
    { "include": "#loop-keywords" },
    { "include": "#import-keywords" },
    { "include": "#declaration-keywords" },
    { "include": "#var-bracket" },
    { "include": "#strings" },
    { "include": "#jsx" },
    { "include": "#arrays" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#function-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kitty",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.kitty",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.kitty" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.kitty" } },
          "patterns": [{ "include": "#string-escapes" }]
        },
        {
          "name": "string.quoted.double.kitty",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.kitty" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.kitty" } },
          "patterns": [{ "include": "#string-escapes" }]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.kitty",
          "match": "\\\\(n|t|\\\\|'|\")"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.kitty",
          "match": "\\b(yes|no)(>)"
        }
      ]
    },
    "type-tags": {
      "patterns": [
        {
          "name": "meta.type-tag.kitty",
          "match": "(<<)(Num|Word|Flag)(>>)",
          "captures": {
            "1": { "name": "punctuation.definition.type-tag.begin.kitty" },
            "2": { "name": "storage.type.kitty" },
            "3": { "name": "punctuation.definition.type-tag.end.kitty" }
          }
        }
      ]
    },
    "loop-keywords": {
      "patterns": [
        {
          "name": "keyword.control.loop.kitty",
          "match": "\\bspin\\b"
        },
        {
          "name": "keyword.control.loop.kitty",
          "match": "\\bin\\b"
        },
        {
          "name": "punctuation.definition.loop-fence.kitty",
          "match": "\\}\\{"
        }
      ]
    },
    "arrays": {
      "patterns": [
        {
          "name": "punctuation.definition.array.kitty",
          "match": "[\\[\\]]"
        }
      ]
    },
    "craft": {
      "patterns": [
        {
          "name": "meta.craft.kitty",
          "match": "\\b(craft)(<)",
          "captures": {
            "1": { "name": "keyword.other.craft.kitty support.function.kitty" },
            "2": { "name": "punctuation.definition.craft.begin.kitty" }
          }
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.kitty",
          "match": "\\b(if|orif|else)(>)"
        },
        {
          "name": "keyword.control.flow.kitty",
          "match": "\\breturn\\b"
        }
      ]
    },
    "declaration-keywords": {
      "patterns": [
        {
          "match": "\\b(private)\\s+(func|purr)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.kitty" },
            "2": { "name": "storage.type.function.kitty" },
            "3": { "name": "entity.name.function.kitty" }
          }
        },
        {
          "match": "\\b(func|purr)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.kitty" },
            "2": { "name": "entity.name.function.kitty" }
          }
        }
      ]
    },
    "import-keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.kitty",
          "match": "\\b(import|from)\\b"
        }
      ]
    },
    "var-bracket": {
      "name": "meta.variable.kitty",
      "begin": "(<)(\\{)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.variable.begin.kitty" },
        "2": { "name": "punctuation.definition.variable.begin.kitty" }
      },
      "end": "(\\})(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.variable.end.kitty" },
        "2": { "name": "punctuation.definition.variable.end.kitty" }
      },
      "patterns": [
        {
          "name": "variable.other.kittine.kitty",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.kitty",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.assignment.kitty",
          "match": ">>"
        },
        {
          "name": "keyword.operator.comparison.kitty",
          "match": "<=|>=|!="
        },
        {
          "name": "keyword.operator.arithmetic.kitty",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.comparison.kitty",
          "match": "!"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.kitty",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.kitty"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.kitty",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "jsx": {
      "patterns": [
        {
          "comment": "Closing tag, e.g. </div>",
          "match": "(</)([A-Za-z_][A-Za-z0-9_.]*)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.kitty" },
            "2": { "name": "entity.name.tag.kitty" },
            "3": { "name": "punctuation.definition.tag.end.kitty" }
          }
        },
        {
          "comment": "Opening / self-closing tag with attributes, e.g. <button onClick={...}> or <input />",
          "name": "meta.tag.kitty",
          "begin": "(<)([A-Za-z_][A-Za-z0-9_.]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.kitty" },
            "2": { "name": "entity.name.tag.kitty" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.kitty" }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name.kitty",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*=)"
            },
            {
              "name": "punctuation.separator.key-value.kitty",
              "match": "="
            },
            { "include": "#strings" },
            { "include": "#var-bracket" },
            {
              "name": "meta.embedded.expression.kitty",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.kitty" } },
              "endCaptures": { "0": { "name": "punctuation.section.embedded.end.kitty" } },
              "patterns": [
                { "include": "#type-tags" },
                { "include": "#booleans" },
                { "include": "#var-bracket" },
                { "include": "#strings" },
                { "include": "#arrays" },
                { "include": "#operators" },
                { "include": "#numbers" },
                { "include": "#identifiers" }
              ]
            }
          ]
        }
      ]
    }
  }
}
