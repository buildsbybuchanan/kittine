# The .rs files under example-app/src/ are compiled output of the
# matching .kitty file (see the "Generated by kittine-compiler. Do not
# edit by hand." header each one starts with) — they aren't hand-written
# Rust, so GitHub's language stats shouldn't count them as such.
# main.rs is the one hand-written exception (it just mounts the compiled
# App component) and is explicitly un-marked below.
example-app/src/*.rs linguist-generated=true
example-app/src/main.rs linguist-generated=false

# kittine-compiler/src/*.rs is the compiler's own hand-written
# implementation — genuinely Rust, left uncovered by the rule above on
# purpose.
